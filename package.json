{
  "name": "propeller-framework",
  "version": "1.0.0",
  "description": "Propeller makes developers life easier: it allows you to create class-styled endpoints to run on your server, with validators and middlewares features inside of it.",
  "scripts": {
    "build": "node build.js"
  },
  "files": [
    "dist/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "author": "Alessio Ferrari <nate3rdz@gmail.com>",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@types/express": "^4.17.13",
    "bcrypt": "^5.0.1",
    "class-validator": "^0.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^8.5.1",
    "morgan": "^1.10.0",
    "reflect-metadata": "^0.1.13",
    "table": "^6.8.2",
    "typeorm": "^0.3.20",
    "zod": "^3.23.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.12",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/morgan": "^1.9.3",
    "@types/node": "^20.0.0",
    "@types/validator": "^13.7.5",
    "esbuild": "^0.20.2",
    "node-ts": "^5.1.2",
    "nodemon": "^3.1.0",
    "npm-dts": "^1.3.12",
    "sqlite3": "^5.1.7",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
